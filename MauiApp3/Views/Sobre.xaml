<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp3.Views.Sobre"
             Title="Sobre"
             BackgroundColor="#1E1E1E">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20" Spacing="15">

        <Label Text="App Hotel" 
               FontSize="30" 
               FontAttributes="Bold" 
               TextColor="#00BFFF" 
               HorizontalOptions="Center"/>

        <Border Padding="20" BackgroundColor="#2D2D2D" StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="10">
                <Label Text="Desenvolvido por:" TextColor="Gray" FontSize="14"/>
                <Label Text="Mariana" TextColor="White" FontSize="20" FontAttributes="Bold"/>

                <Label Text="Ano de Desenvolvimento:" TextColor="Gray" FontSize="14" Margin="0,10,0,0"/>
                <Label Text="2026" TextColor="White" FontSize="20" FontAttributes="Bold"/>

                <Label Text="Análise e desenvolvimento de sistemas" 
                       TextColor="#00BFFF" 
                       FontSize="14" 
                       Margin="0,15,0,0"/>
            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar" BackgroundColor="#00BFFF" TextColor="Black" FontAttributes="Bold" Clicked="Button_Clicked"/>

    </VerticalStackLayout>
</ContentPage>