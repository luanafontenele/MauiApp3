<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp3.Views.ContratacaoHospedagem"
             Title="Contratação de Hospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1E1E1E">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" Padding="20" Spacing="15">

            <Label Text="Cálculo da Diária" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="#FFD700" 
                   HorizontalOptions="Center" />

            <Border Padding="15" BackgroundColor="#2D2D2D" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="10">

                    <!-- Hóspedes (Stepper) -->
                    <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" TextColor="White" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Value}" BindingContext="{x:Reference stp_adultos}" TextColor="#FFD700" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Stepper Grid.Row="0" Grid.Column="2" x:Name="stp_adultos" Minimum="0" Maximum="10" Increment="1" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" TextColor="White" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value}" BindingContext="{x:Reference stp_criancas}" TextColor="#FFD700" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Stepper Grid.Row="1" Grid.Column="2" x:Name="stp_criancas" Minimum="0" Maximum="10" Increment="1" />
                    </Grid>

                    <!-- Escolha da Suíte (Picker) -->
                    <Label Text="Escolha sua Suíte" TextColor="White" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Picker x:Name="pck_quarto" 
                            Title="Selecione sua Acomodação" 
                            ItemDisplayBinding="{Binding Descricao}"
                            TextColor="White"
                            TitleColor="Gray"/>

                    <!-- Período da Estadia (DatePicker) -->
                    <Border Padding="10" BackgroundColor="#3A3A3A" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Período da Estadia" TextColor="#FFD700" FontAttributes="Bold"/>

                            <HorizontalStackLayout Spacing="10">
                                <Label Text="Check-in:" TextColor="White" VerticalOptions="Center"/>
                                <DatePicker x:Name="dtpck_checkin" Format="dd/MM/yyyy" TextColor="White" DateSelected="dtpck_checkin_DateSelected"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="10">
                                <Label Text="Check-out:" TextColor="White" VerticalOptions="Center"/>
                                <DatePicker x:Name="dtpck_checkout" Format="dd/MM/yyyy" TextColor="White"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Botões -->
                    <Button Text="Avançar" BackgroundColor="#FFD700" TextColor="Black" FontAttributes="Bold" Clicked="Button_Clicked"/>
                    <Button Text="Sobre o App" BackgroundColor="Transparent" TextColor="#FFD700" BorderColor="#FFD700" BorderWidth="1" Clicked="BtnSobre_Clicked"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>